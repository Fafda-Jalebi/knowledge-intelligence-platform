# Docker Compose Environment Variables
# Copy to .env and customize

# Database
POSTGRES_PASSWORD=kip_secret_change_me_in_production

# JWT Secret (generate with: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Optional: LLM Provider API Keys (uncomment and set to use)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# Optional: Qdrant API Key (if using authenticated Qdrant)
# QDRANT_API_KEY=...

# Frontend
VITE_API_BASE_URL=http://localhost:8000
